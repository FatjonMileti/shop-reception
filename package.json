{
  "name": "carrefour-base-app",
  "version": "1.0.0",
  "main": "src",
  "license": "MIT",
  "scripts": {
    "start": "webpack serve --node-env=development --env environment=development",
    "start:local": "webpack serve --node-env=development --env environment=local --port 3000",
    "start:dev": "webpack serve --node-env=development --env environment=development",
    "start:https": "webpack serve --server-type https --node-env=development --env environment=development",
    "build:dev": "NODE_OPTIONS=--max_old_space_size=4096 webpack --node-env=production --env environment=dev",
    "build:prod": "NODE_OPTIONS=--max_old_space_size=4096 webpack --node-env=production --env environment=production",
    "build:uat": "NODE_OPTIONS=--max_old_space_size=4096 webpack --node-env=production --env environment=uat",
    "build:stats": "NODE_OPTIONS=--max_old_space_size=4096 webpack --node-env=production --env environment=production --json > stats.json",
    "clean": "rm -rf node_modules && rm yarn.lock",
    "clean:start": "yarn clean && yarn && yarn start",
    "build:deploy": "yarn clean && yarn && yarn build",
    "build:deploy:dev": "yarn clean && yarn && yarn build:dev",
    "win-build:deploy": "yarn win-clean && yarn && yarn win-build",
    "win-clean": "del /F /Q node_modules",
    "win-build:dev": "set NODE_OPTIONS=--max_old_space_size=4096 && webpack --node-env=production --env environment=dev",
    "win-build:uat": "set NODE_OPTIONS=--max_old_space_size=4096 && webpack --node-env=production --env environment=uat",
    "win-build:prod": "set NODE_OPTIONS=--max_old_space_size=4096 && webpack --node-env=production --env environment=production",
    "lint:check": "eslint src/.; exit 0",
    "lint:fix": "eslint --fix src/.; exit 0",
    "tsc": "tsc"
  },
