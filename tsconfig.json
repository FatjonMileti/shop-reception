{
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "./built",
    "allowJs": true,
    "module": "esnext",
    "target": "es5",
    "baseUrl": "./src",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    // "strict": true,
    "downlevelIteration": true,
    "lib": ["dom", "es2021", "webworker"]
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "*/node_modules/"]
}
